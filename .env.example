# 麟阁 MemHall 环境变量模板（复制为 .env 使用，真 key 不入 git）
# judge 双端点（OpenAI 兼容；选型避开与被测智能体后端同家族）

JUDGE_A_BASE_URL=
JUDGE_A_KEY=
JUDGE_A_MODEL=

JUDGE_B_BASE_URL=
JUDGE_B_KEY=
JUDGE_B_MODEL=

# 被测智能体的 LLM 后端（独立 key，与 judge 消耗分开记账）
AGENT_LLM_BASE_URL=
AGENT_LLM_KEY=
AGENT_LLM_MODEL=

# claude-local 适配器（anthropic 协议端点；不设则回落 shell 里已有的 ANTHROPIC_*）
# 例：https://open.bigmodel.cn/api/anthropic
CLAUDE_LLM_BASE_URL=
CLAUDE_LLM_KEY=
CLAUDE_LLM_MODEL=

# qwen-local 适配器：认证读 ~/.qwen/settings.json，无需额外变量；
# AGENT_LLM_MODEL 会覆盖沙箱里的模型名（与 hermes/kylinbot 同网关口径）

# 统一模型网关（memhall gateway）——被测智能体流量必经本地代理，保证对照时同后端同模型。
# 网关侧（真凭据只放这，别进命令行）：
GATEWAY_UPSTREAM_URL=
GATEWAY_UPSTREAM_KEY=
GATEWAY_MODEL=
# 智能体侧（设了 GATEWAY_URL 即激活统一模式，dummy key 自动按 memhall-<适配器> 派生）：
GATEWAY_URL=                    # 本机智能体用，如 http://127.0.0.1:8311/v1
GATEWAY_VM_URL=                 # VM 内智能体用（宿主网关的 VM 可达地址），如 http://192.168.61.1:8311/v1
GATEWAY_MIN_INTERVAL=           # 网关转发最小间隔秒，默认 8（≈7.5 RPM 防上游限流掐线；0 关闭）
GATEWAY_BACKOFF_BASE=           # 上游 429/5xx 指数退避基数秒，默认 2（每次翻倍）
GATEWAY_BACKOFF_MAX=            # 退避封顶秒，默认 30（尊重 Retry-After 且同样封顶）

# openKylin 评测虚拟机 SSH（被测智能体所在宿主环境）
# VM_HOST 示例：openKylin VM NAT 网段常为 192.168.x.x（按实际环境填）
# openKylin 原生部署（麟阁直接装在 openKylin 上跑）：VM_HOST 填 127.0.0.1，
# VM_USER/VM_PASS 用本机 SSH 账号——hermes/kylinbot/openclaw 走本机回环 SSH 驱动
VM_HOST=
VM_USER=okim
VM_PASS=

# vm 子命令（vmrun 生命周期管理，可选）
VMX_PATH=D:\VMware3\openkylin30.vmx
VMRUN=D:\VMware\vmrun.exe
# VM_SNAPSHOT=agents-warm
